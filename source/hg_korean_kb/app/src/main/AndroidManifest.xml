<?xml version="1.0" encoding="utf-8"?>
<!--
  HG Keyboard IME — Android 10 (API 29)

  Shared by Gradle APK builds and AOSP Soong (Android.bp).

  package: com.higenis.keyboard
  service: com.higenis.keyboard.HGKeyboardService
  IME ID:  com.higenis.keyboard/.HGKeyboardService
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.higenis.keyboard">

    <!-- Aligns with product target Android 10; Gradle also sets min/target 29. -->
    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="29" />

    <!--
      No INTERNET / storage / network permissions.
      BIND_INPUT_METHOD on the service restricts who may bind (the system).
      directBootAware intentionally omitted (default false) for SharedPreferences.
    -->

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true">

        <service
            android:name=".HGKeyboardService"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
